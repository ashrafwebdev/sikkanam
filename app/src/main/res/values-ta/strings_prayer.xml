    <string name="prayer_override_title">பள்ளிவாசலின் சொந்த நேரங்கள் (விருப்பம்)</string>
    <string name="prayer_override_desc">கணக்கிடப்பட்ட நேரத்திலிருந்து உங்கள் பள்ளிவாசலின் நேரம் வேறுபட்டால் இங்கே உள்ளிடுங்கள். காலியாக விட்டால் கணக்கிடப்பட்ட நேரம் காட்டப்படும்.</string>
    <string name="prayer_range_title">இந்த நேரங்கள் பொருந்தும் நாட்கள் (விருப்பம்)</string>
    <string name="prayer_range_desc">இரண்டு தேதிகளையும் காலியாக விட்டால் இந்த நேரங்கள் எப்போதும் பயன்படுத்தப்படும். தேதிகளுக்கு வெளியே கணக்கிடப்பட்ட நேரங்கள் காட்டப்படும்.</string>
    <string name="prayer_range_from">தொடக்கம் (dd/mm/yyyy)</string>
    <string name="prayer_range_to">முடிவு (dd/mm/yyyy)</string>
    <string name="prayer_range_error">சரியான தேதிகளை உள்ளிடுங்கள். முடிவு தேதி தொடக்க தேதிக்கு முன் இருக்கக்கூடாது.</string>
    <string name="prayer_masjids_title">நீங்கள் தொழும் பள்ளிவாசல்கள் (5 வரை)</string>
    <string name="prayer_masjids_desc">நீங்கள் இருக்கும் பள்ளிவாசலைத் தேர்ந்தெடுங்கள். அதன் நேரங்கள் முகப்பில் காட்டப்படும்.</string>
    <string name="prayer_masjids_none">இன்னும் பள்ளிவாசல் சேர்க்கப்படவில்லை.</string>
